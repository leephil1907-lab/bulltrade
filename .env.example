# Blockchain Bullhorn — environment configuration
# Copy to .env and adjust. The .env file is never served by the web server
# and must never be committed to version control.

# JWT signing secret (HS256) for session tokens.
# If unset, the server auto-generates one and stores it in data/.jwt-secret
# (mode 0600, outside the public web root). Minimum 16 characters.
JWT_SECRET=

# HTTP port (default 3000)
PORT=3000

# Live order execution is blocked unless this is explicitly set to true.
# Do not enable until a real execution/custody model and settlement checks
# have been reviewed and verified.
 # Reserved for a future provider integration; does not enable live trading today.
LIVE_TRADING_ENABLED=false

# Optional isolated data directory (primarily for tests/local deployments).
BULLTRADE_DATA_DIR=

# Data persistence for ephemeral hosts (Render free tier).
# BACKUP_REPO must be a PRIVATE GitHub repository ("owner/name"); database JSON
# sync is a temporary persistence fallback. Uploads (KYC/deposit proofs) are NOT
# synced unless BACKUP_UPLOADS_ENABLED=true. Prefer private object storage for uploads.
# BACKUP_TOKEN needs a personal access token with repo scope.
BACKUP_REPO=
BACKUP_TOKEN=
BACKUP_BRANCH=main
BACKUP_DIR=data
# Sensitive uploads are excluded from GitHub backup by default.
BACKUP_UPLOADS_ENABLED=false

# Initial admin account (used on first boot to seed the admin user).
# If ADMIN_PASSWORD is not set, a random one is generated and printed
# to the console once — save it and change it after first login.
ADMIN_EMAIL=admin@blockchainbullhorn.com
ADMIN_PASSWORD=
