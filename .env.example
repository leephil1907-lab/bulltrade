# Blockchain Bullhorn — environment configuration
# Copy to .env and adjust. The .env file is never served by the web server
# and must never be committed to version control.

# JWT signing secret (HS256) for session tokens.
# If unset, the server auto-generates one and stores it in data/.jwt-secret
# (mode 0600, outside the public web root). Minimum 16 characters.
JWT_SECRET=

# HTTP port (default 3000)
PORT=3000

# Data persistence for ephemeral hosts (Render free tier).
# BACKUP_REPO must be a PRIVATE GitHub repository ("owner/name"); the app
# syncs data/db.json + data/uploads/ to it and restores them on boot.
# BACKUP_TOKEN needs a personal access token with repo scope.
BACKUP_REPO=
BACKUP_TOKEN=
BACKUP_BRANCH=main
BACKUP_DIR=data

# Initial admin account (used on first boot to seed the admin user).
# If ADMIN_PASSWORD is not set, a random one is generated and printed
# to the console once — save it and change it after first login.
ADMIN_EMAIL=admin@blockchainbullhorn.com
ADMIN_PASSWORD=

# ---- Wallet addresses (survive redeploys on ephemeral hosts) ----
# data/db.json is wiped whenever the host rebuilds (Render free tier). Set the
# addresses here as well so they are re-applied automatically on every boot.
# Values here always win over what is stored in the admin panel.
#
# JSON form for every funding wallet:
DEPOSIT_ADDRESSES={"BTC":"bc1q...","USDT":"T...","USDT-ERC20":"0x...","ETH":"0x...","SOL":"...","BNB":"0x...","XRP":"r...","LTC":"ltc1...","DOGE":"D...","TRX":"T...","ZEC":"t1..."}
# JSON form for the store checkout wallet (USDT ERC-20 only):
PRODUCT_PAYMENT_ADDRESSES={"USDT-ERC20":"0x..."}
# Optional per-coin shorthand (hyphens become underscores): ADDRESS_BTC, ADDRESS_USDT, ADDRESS_USDT_ERC20 …
# ADDRESS_BTC=bc1q...
