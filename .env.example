# Blockchain Bullhorn — environment configuration
# Copy to .env and adjust. The .env file is never served by the web server
# and must never be committed to version control.

# JWT signing secret (HS256) for session tokens.
# If unset, the server auto-generates one and stores it in data/.jwt-secret
# (mode 0600, outside the public web root). Minimum 16 characters.
JWT_SECRET=

# HTTP port (default 3000)
PORT=3000

# Data persistence for ephemeral hosts (Render free tier).
# BACKUP_REPO must be a PRIVATE GitHub repository ("owner/name"); the app
# syncs data/db.json + data/uploads/ to it and restores them on boot.
# BACKUP_TOKEN needs a personal access token with repo scope.
BACKUP_REPO=
BACKUP_TOKEN=
BACKUP_BRANCH=main
BACKUP_DIR=data

# Initial admin account (used on first boot to seed the admin user).
# If ADMIN_PASSWORD is not set, a random one is generated and printed
# to the console once — save it and change it after first login.
ADMIN_EMAIL=admin@blockchainbullhorn.com
ADMIN_PASSWORD=

# ---- Wallet addresses (survive redeploys on ephemeral hosts) ----
# data/db.json is wiped whenever the host rebuilds (Render free tier). Set the
# addresses here as well so they are re-applied automatically on every boot.
# Values here always win over what is stored in the admin panel.
#
# JSON form for every funding wallet:
DEPOSIT_ADDRESSES={"BTC":"bc1q...","USDT":"T...","USDT-ERC20":"0x...","ETH":"0x...","SOL":"...","BNB":"0x...","XRP":"r...","LTC":"ltc1...","DOGE":"D...","TRX":"T...","ZEC":"t1..."}
# JSON form for the store checkout wallet (USDT ERC-20 only):
PRODUCT_PAYMENT_ADDRESSES={"USDT-ERC20":"0x..."}
# Optional per-coin shorthand (hyphens become underscores): ADDRESS_BTC, ADDRESS_USDT, ADDRESS_USDT_ERC20 …
# ADDRESS_BTC=bc1q...

# ---- Email delivery (survives redeploys on ephemeral hosts) ----
# Same story as the wallets: anything typed into Admin → Settings → Email lives in
# data/db.json, which the free tier wipes on every deploy. Set it here instead —
# env always wins and is re-applied on every boot.
#
# Gmail / Google Workspace (needs a 16-char App Password, NOT the account password;
# 2-Step Verification must be on: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=blockchainbullhornfaqs@gmail.com
SMTP_PASS=
SMTP_FROM=blockchainbullhornfaqs@gmail.com
#
# Pick how mail leaves the server. 'smtp' is the default, but NOTE: the Render FREE
# tier blocks outbound ports 25/465/587, so plain SMTP cannot connect there. On the
# free tier use one of the HTTP transports instead:
#   EMAIL_TRANSPORT=sendgrid   + SENDGRID_API_KEY=SG.xxxx     (free 100/day)
#   EMAIL_TRANSPORT=relay      + MAIL_RELAY_URL=... MAIL_RELAY_SECRET=...
#                                (Google Apps Script web app, sends from Gmail)
EMAIL_TRANSPORT=smtp
SENDGRID_API_KEY=
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=

# Public support address + where owner notifications go (new leads, alerts).
SUPPORT_EMAIL=blockchainbullhornfaqs@gmail.com
NOTIFY_EMAIL=blockchainbullhornfaqs@gmail.com

# Canonical site URL — used for canonical tags, sitemap, robots.txt and email links.
SITE_URL=https://bulltrade-fmtf.onrender.com

# ---- User-specific custody wallet provisioning (optional; disabled by default) ----
# These are server-side only. WALLET_PROVIDER_URL must point to your private adapter
# implementing POST /v1/user-wallets as documented in WALLET_PROVISIONING.md.
WALLET_PROVIDER_URL=
WALLET_PROVIDER_API_KEY=
# Optional comma-separated network allowlist; defaults are documented in WALLET_PROVISIONING.md.
WALLET_SUPPORTED_NETWORKS=
