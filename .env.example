# Blockchain Bullhorn — environment configuration
# Copy to .env and adjust. The .env file is never served by the web server
# and must never be committed to version control.
#
# On Render you do NOT need this file — every variable below is already declared
# in render.yaml and prompted for (or generated) during the first blueprint sync.
# This file is the reference for local runs and other hosts.

# ---- runtime ----
NODE_ENV=production
# HTTP port (default 3000). Platforms inject this automatically.
PORT=3000

# ---- persistent data directory (THE most important setting on Render) ----
# Absolute path where db.json, uploads/, market-cache.json and .jwt-secret live.
# Must match the persistent disk's mountPath exactly, or the disk is mounted
# somewhere the app never writes and data stays ephemeral while looking saved.
#
#   Render native Node runtime (what render.yaml uses):  /var/data
#   Render Docker runtime:                               /app/data
#   local dev / VPS:                                     leave blank -> <repo>/data
#
# Do NOT use /app/data with the native Node runtime: /app is the Docker WORKDIR
# and does not exist there. Render's Node source tree is /opt/render/project/src,
# and these exact paths are rejected as mount points: /, /opt, /opt/render,
# /opt/render/project, /opt/render/project/src, /home, /home/render, /etc,
# /etc/secrets.
DATA_DIR=/var/data

# ---- JWT signing secret (HS256) for session tokens ----
# If unset, the server auto-generates one and stores it in DATA_DIR/.jwt-secret
# (mode 0600, outside the public web root). Minimum 16 characters.
# render.yaml sets `generateValue: true` so Render mints a strong 256-bit secret
# and leaves an existing one alone (regenerating it would log everyone out).
JWT_SECRET=

# ---- canonical site URL ----
# Drives canonical/OG/JSON-LD absolute URLs, sitemap.xml, robots.txt and every
# link inside transactional email. Update it whenever the domain changes.
SITE_URL=https://blockchainbullhorn.onrender.com

# ---- initial admin account (first boot only) ----
# If ADMIN_PASSWORD is not set, a random one is generated and printed to the
# console once — save it and change it after first login.
ADMIN_EMAIL=admin@blockchainbullhorn.com
ADMIN_PASSWORD=

# ---- request throttling (lib/ratelimit.js) ----
# Protects signup, password reset, 2FA, lead capture, support tickets and chat
# from spam, credential stuffing and mail-quota burn.
#   on  = force-enable     off = force-disable
#   (unset = enabled when NODE_ENV=production, which is what you want in prod;
#    the e2e suite turns it off so it can create many accounts from one IP)
RATE_LIMIT=on
# Optional per-route overrides, format max/windowMs. Rule names are uppercased:
# SIGNUP, TWOFA, FORGOT, RESET, LEADS, TICKET, CHATINIT, CHATSEND.
# Defaults: signup 8/hr per IP + 3/hr per IP+email, forgot 6/hr + 3/hr,
#           leads 15/hr + 5/hr, 2FA 20/15min, reset 10/hr, ticket 12/hr,
#           chat 15/hr init + 60/10min send.
# Failed LOGINS are limited separately by lib/auth.js (10 per email+IP / 15 min).
#RATE_LIMIT_SIGNUP=20/3600000
#RATE_LIMIT_LEADS=30/3600000

# ---- static asset cache ----
# In-memory budget (MB) for memoised static files, validated by mtime+size and
# served with an ETag so repeat visitors get a 304 instead of the bytes. All 257
# assets total ~21 MB, so the default holds the entire site; the app idles near
# 70 MB RSS and peaks around 115 MB fully saturated (Starter = 512 MB).
# Set to 8 (the floor) to effectively disable caching.
STATIC_CACHE_MB=64

# ---- wallet addresses ----
# With a persistent disk these survive redeploys, so Admin -> Settings -> Crypto
# Deposit Addresses is enough. Setting them here as well is still worthwhile as a
# guarantee against an empty or rolled-back disk: env always wins on boot.
#
# JSON form for every funding wallet:
DEPOSIT_ADDRESSES={"BTC":"bc1q...","USDT":"T...","USDT-ERC20":"0x...","ETH":"0x...","SOL":"...","BNB":"0x...","XRP":"r...","LTC":"ltc1...","DOGE":"D...","TRX":"T...","ZEC":"t1..."}
# JSON form for the store checkout wallet (USDT ERC-20 only):
PRODUCT_PAYMENT_ADDRESSES={"USDT-ERC20":"0x..."}
# Optional per-coin shorthand (hyphens become underscores): ADDRESS_BTC, ADDRESS_USDT, ADDRESS_USDT_ERC20 …
# ADDRESS_BTC=bc1q...

# ---- email delivery ----
# PAID Render instances can open outbound ports 25/465/587, so plain SMTP is the
# recommended transport and the HTTP-relay workarounds are no longer needed.
# (The Render FREE tier blocks all SMTP ports platform-wide — use sendgrid or
# relay there.)
#
# Gmail / Google Workspace needs a 16-character App Password, NOT the account
# password; 2-Step Verification must be on:
#   https://myaccount.google.com/apppasswords
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=blockchainbullhornfaqs@gmail.com
SMTP_PASS=
SMTP_FROM=blockchainbullhornfaqs@gmail.com
#
# HTTP alternatives (required on the free tier, optional anywhere):
#   EMAIL_TRANSPORT=sendgrid + SENDGRID_API_KEY=SG.xxxx        (free 100/day)
#   EMAIL_TRANSPORT=relay    + MAIL_RELAY_URL + MAIL_RELAY_SECRET
#                            (Google Apps Script web app, sends from Gmail)
SENDGRID_API_KEY=
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=

# Public support address + where owner notifications go (new leads, alerts).
SUPPORT_EMAIL=blockchainbullhornfaqs@gmail.com
NOTIFY_EMAIL=blockchainbullhornfaqs@gmail.com

# ---- optional off-site backup (NO LONGER REQUIRED on a paid plan) ----
# The persistent disk is the primary store and Render snapshots it every 24 h
# (kept 7 days). Setting these additionally mirrors data/db.json + data/uploads/
# into a PRIVATE GitHub repo after every change, giving indefinite off-site
# history on top of the 7-day snapshots. Leave both blank to disable.
#
# BACKUP_REPO must be a PRIVATE repository ("owner/name") — it holds user data
# and password hashes. BACKUP_TOKEN needs repo scope. One backup repo per
# instance: two instances sharing a repo will fight.
BACKUP_REPO=
BACKUP_TOKEN=
BACKUP_BRANCH=main
BACKUP_DIR=

# ---- boot-integrity guard (lib/db.js init) ----
# If BACKUP_REPO is set but the backup cannot be restored — bad/expired token,
# wrong repo or branch, GitHub unreachable — the app REFUSES TO BOOT and exits
# non-zero instead of seeding an empty database. This is deliberate: continuing
# would seed a fresh db.json that the 10-minute sync then PUTs over your real
# backup, destroying every user, wallet and ledger entry with no way back.
# Render restarts the container and the restore is retried.
#
# Set ALLOW_EMPTY_BOOT=1 ONLY for a genuine first-ever deployment where there is
# truly nothing to lose. It starts the app AND disables the backup sync for that
# process, so it still cannot overwrite anything.
# ALLOW_EMPTY_BOOT=1

# Restore retries before giving up (2s, 4s backoff between attempts).
# RESTORE_ATTEMPTS=3

# ---- optional CRM sync (lib/hubspot.js) ----
# Server-side only. Never expose this token to browser code or commit it.
# HubSpot failures never block auth, trading, wallet or ledger operations.
HUBSPOT_ACCESS_TOKEN=

# ---- PostgreSQL (PHASE 1: migration tooling only — the app ignores this) ----
# Nothing in server.js or lib/*.js opens a connection yet. DATABASE_URL is read
# only by tools/pg-migrate.js, tools/pg-parity.js, tests/pg.js and lib/pg.js.
# Setting it cannot change runtime behaviour; the JSON store at DATA_DIR/db.json
# is still authoritative. See docs/POSTGRES_MIGRATION.md before enabling the
# `databases:` block in render.yaml.
#
# WARNING: tests/pg.js TRUNCATEs its target database and refuses to run unless
# the database name contains test/tmp/scratch/dev/ci. Use a throwaway database.
DATABASE_URL=

# Optional pool tuning (the defaults are fine at numInstances: 1).
# Read by lib/pg.js. Idle connections are reaped after 30 s regardless.
# PG_POOL_MAX=5             # concurrent connections; keep low — Render's
#                           # basic Postgres caps connections, and the service
#                           # is pinned to a single instance anyway
# PG_CONNECT_TIMEOUT=10000  # ms to wait for a connection before failing
# PGSSLMODE=require         # disable | require | verify-ca | verify-full
#                           # "require" for Render's EXTERNAL connection string
#                           # (self-signed cert); leave unset for the internal
#                           # one. Also honoured if present in DATABASE_URL as
#                           # ?sslmode=require

# ---- Render runtime pin ----
# Render reads NODE_VERSION first, then .node-version, then .nvmrc, then
# package.json engines. Its default moves over time, so pin it for reproducible
# builds. render.yaml sets this; it is harmless (ignored) elsewhere.
NODE_VERSION=20.20.2
